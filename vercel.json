{
    "rewrites": [
        {
            "source": "/.well-known/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/register",
            "destination": "/api/index.js"
        },
        {
            "source": "/authorize",
            "destination": "/api/index.js"
        },
        {
            "source": "/token",
            "destination": "/api/index.js"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/index.js": {
            "maxDuration": 60
        },
        "api/cron/refresh-israeli-prices.js": {
            "maxDuration": 60
        }
    },
    "crons": [
        {
            "path": "/api/cron/refresh-israeli-prices",
            "schedule": "0 14 * * 0-4"
        }
    ]
}